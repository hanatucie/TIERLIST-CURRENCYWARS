    .page-tab-btn::before {
      content: "";
      position: absolute;
      top: -70%;
      left: -70%;
      width: 240%;
      height: 240%;
      background: conic-gradient(
        from 0deg,
        transparent 0deg,
        transparent 45deg,
        #00f2fe 100deg,
        #a29bfe 180deg,
        #f1c40f 260deg,
        #00f2fe 360deg
      );
