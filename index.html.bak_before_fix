    function showEquipTooltip(e, name) {
      let data = EQUIP_META[name];
      if (!data) {
        const c = (e && e.currentTarget) || document.querySelector(`.equip-card[data-name="${CSS.escape(name)}"]`);
        if (c) {
          data = { name: name, icon: c.getAttribute("data-icon"), bonus: c.getAttribute("data-bonus"), desc: c.getAttribute("data-desc") };
        }
      }
      if (!data) return;
      const tt = document.getElementById('equipTooltip');
      document.getElementById('ttName').textContent = name;
      document.getElementById('ttImg').src = data.icon || 'assets/trang_bi/001_ngoc_tai_loc.png';
      
      const bonusEl = document.getElementById('ttBonus');
      if (data.bonus) {
        bonusEl.textContent = data.bonus;
        bonusEl.style.display = 'block';
      } else {
        bonusEl.style.display = 'none';
      }
      
      const descEl = document.getElementById('ttDesc');
      descEl.textContent = data.desc || 'Chưa có mô tả chi tiết.';
      
      tt.style.display = 'block';
      moveTooltip(e);
      document.addEventListener('mousemove', moveTooltip);
    }

    function moveTooltip(e) {
      const tt = document.getElementById('equipTooltip');
      if (!tt || tt.style.display === 'none') return;
      const pad = 15;
      let x = e.clientX + pad;
      let y = e.clientY + pad;
      
      // Keep inside viewport
      const rect = tt.getBoundingClientRect();
      if (x + rect.width > window.innerWidth) {
        x = e.clientX - rect.width - pad;
      }
      if (y + rect.height > window.innerHeight) {
        y = e.clientY - rect.height - pad;
      }
      tt.style.left = x + 'px';
      tt.style.top = y + 'px';
    }

    function hideEquipTooltip() {
      const tt = document.getElementById('equipTooltip');
      if (tt) tt.style.display = 'none';
      document.removeEventListener('mousemove', moveTooltip);
    }

    function showEquipModal(name) {
      hideEquipTooltip();
      let data = EQUIP_META[name];
      if (!data) {
        const c = document.querySelector(`.equip-card[data-name="${CSS.escape(name)}"]`);
        if (c) {
          data = { name: name, icon: c.getAttribute("data-icon"), bonus: c.getAttribute("data-bonus"), desc: c.getAttribute("data-desc") };
        }
      }
      if (!data) return;
      document.getElementById('equipModalName').textContent = name;
      document.getElementById('equipModalImg').src = data.icon || 'assets/trang_bi/001_ngoc_tai_loc.png';
      document.getElementById('equipModalBonus').textContent = data.bonus || 'Không có chỉ số cộng thêm';
      document.getElementById('equipModalDesc').textContent = data.desc || 'Chưa có mô tả chi tiết';
      document.getElementById('equipModalBackdrop').classList.add('open');
    }

    function filterEquipment() {
      const q = document.getElementById('equipSearchInput').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.equip-card');
      cards.forEach(card => {
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const bonus = (card.getAttribute('data-bonus') || '').toLowerCase();
        const desc = (card.getAttribute('data-desc') || '').toLowerCase();
        const match = !q || name.includes(q) || bonus.includes(q) || desc.includes(q);
        card.style.display = match ? 'flex' : 'none';
      });
    }

    // Mặc định mở Xếp Hạng Đội Hình trước thay vì Sổ Tay Liên Kết
    window.addEventListener('DOMContentLoaded', () => {
      const layout = document.getElementById('appLayout');
      if (layout) layout.classList.add('sidebar-collapsed');

      const teamSidebar = document.getElementById('teamSidebar');
      if (teamSidebar) {
        teamSidebar.classList.add('open');
        renderTeamList();
      }
    });

  </script>

  <!-- Floating Tooltip for Equipment -->
  <div class="equip-tooltip" id="equipTooltip" style="display: none;">
    <div class="equip-tooltip-header">
      <img id="ttImg" src="" class="equip-tooltip-icon">
      <div>
        <div class="equip-tooltip-name" id="ttName">Tên Trang Bị</div>
        <div class="equip-tooltip-tag">Trang Bị</div>
      </div>
    </div>
    <div class="equip-tooltip-bonus" id="ttBonus"></div>
    <div class="equip-tooltip-desc" id="ttDesc"></div>
  </div>

  <!-- Equipment Modal for Mobile/Click -->
  <div class="modal-backdrop" id="equipModalBackdrop" onclick="handleBackdropClick(event, 'equipModalBackdrop')">
    <div class="modal-box equip-modal-box">
      <div class="modal-header">
        <div class="modal-header-profile">
          <img class="equip-modal-img" id="equipModalImg" src="" alt="">
          <div class="modal-char-info">
            <div class="modal-char-name">
              <span id="equipModalName">Trang Bị</span>
            </div>
            <div class="equip-modal-tags">
              <span class="talent-tag" style="background:#3867d6;">Trang Bị</span>
            </div>
          </div>
        </div>
        <button class="btn-close-modal" onclick="closeModal('equipModalBackdrop')">✕</button>
      </div>
      <div class="modal-body">
        <div class="section-title">📊 Chỉ Số & Thuộc Tính</div>
        <div class="equip-modal-bonus-card" id="equipModalBonus">-</div>
        <div class="section-title" style="margin-top:16px;">📜 Hiệu Ứng Chi Tiết</div>
        <div class="equip-modal-desc-card" id="equipModalDesc">-</div>
      </div>
    </div>
  </div>

</body>
</html>


