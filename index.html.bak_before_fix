<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Honkai: Star Rail — CE Tier List & Sổ Tay Liên Kết</title>
  <style>
    :root {
      --bg-dark: #0a0b12;
      --bg-panel: rgba(20, 22, 35, 0.92);
      --bg-card: rgba(28, 30, 48, 0.75);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-light: rgba(255, 255, 255, 0.16);
      --text-main: #f1f2f6;
      --text-muted: #a4b0be;
      --accent-gold: #f1c40f;
      --accent-cyan: #00f2fe;
      --accent-blue: #3867d6;
      --cost-5: #f1c40f;
      --cost-4: #a55eea;
      --cost-3: #3867d6;
      --cost-2: #20bf6b;
      --cost-1: #95a5a6;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 12% 18%, rgba(56, 103, 214, 0.14) 0%, transparent 40%),
        radial-gradient(circle at 88% 82%, rgba(243, 104, 224, 0.12) 0%, transparent 40%),
        radial-gradient(circle at 50% 50%, #0d0f17 0%, #06070a 100%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.5;
    }

    /* Header */
    header {
      background: rgba(14, 16, 26, 0.92);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 28px;
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .logo-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .logo-badge {
      background: linear-gradient(135deg, #f1c40f, #e67e22);
      color: #000;
      font-weight: 900;
      font-size: 13px;
      padding: 5px 12px;
      border-radius: 6px;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .logo-badge:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(241, 196, 15, 0.45);
      color: #000;
    }

    h1 {
      font-size: 19px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: #ffffff;
      text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .sub-title {
      font-size: 12px;
      color: var(--text-muted);
    }

    /* Controls bar */
    .controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .search-box {
      position: relative;
      width: 240px;
    }

    .search-box input {
      width: 100%;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-light);
      border-radius: 20px;
      padding: 7px 14px 7px 32px;
      color: #fff;
      font-size: 13px;
      outline: none;
      transition: all 0.2s;
    }

    .search-box input:focus {
      border-color: var(--accent-cyan);
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.3);
      background: rgba(255, 255, 255, 0.1);
    }

    .search-box svg {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      fill: var(--text-muted);
      width: 14px;
      height: 14px;
    }

    .filter-select {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-light);
      color: #fff;
      padding: 7px 12px;
      border-radius: 8px;
      font-size: 13px;
      outline: none;
      cursor: pointer;
    }

    .filter-select option {
      background: #1b1d2e;
      color: #fff;
    }

    /* Glowing Border Rotation Keyframe */
    @keyframes borderGlowRotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .btn-toggle-sidebar {
      position: relative;
      overflow: hidden;
      background: transparent;
      border: none;
      color: #00f2fe;
      padding: 9px 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      z-index: 1;
      letter-spacing: 0.3px;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 0 15px rgba(0, 242, 254, 0.25);
    }

    .btn-toggle-sidebar::before {
      content: "";
      position: absolute;
      top: -65%;
      left: -65%;
      width: 230%;
      height: 230%;
      background: conic-gradient(
        from 0deg,
        transparent 0deg,
        transparent 45deg,
        #00f2fe 110deg,
        #4facfe 180deg,
        #6c5ce7 260deg,
        #00f2fe 360deg
      );
      animation: borderGlowRotate 3.2s linear infinite;
      z-index: -2;
    }

    .btn-toggle-sidebar::after {
      content: "";
      position: absolute;
      inset: 2px;
      background: linear-gradient(135deg, #0d1730 0%, #0d1020 100%);
      border-radius: 8px;
      z-index: -1;
      transition: background 0.2s;
    }

    .btn-toggle-sidebar:hover {
      transform: translateY(-2px);
      color: #fff;
      box-shadow: 0 0 25px rgba(0, 242, 254, 0.55);
    }

    .btn-toggle-sidebar:hover::after {
      background: linear-gradient(135deg, #15254d 0%, #11152d 100%);
    }

    /* Main Container Grid */
    .app-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 20px;
      padding: 20px 28px;
      max-width: 1750px;
      margin: 0 auto;
      transition: grid-template-columns 0.3s ease;
    }

    .app-layout.sidebar-collapsed {
      grid-template-columns: 1fr 0px;
    }

    .app-layout.sidebar-collapsed .links-sidebar {
      display: none;
    }

        /* Rank / Tierlist Team Badges */
    .team-rank-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 6px;
      letter-spacing: 0.5px;
      flex-shrink: 0;
      min-width: 52px;
      text-transform: uppercase;
    }
    .team-rank-badge.rank-1 {
      background: linear-gradient(135deg, #f1c40f, #e67e22);
      color: #000;
      box-shadow: 0 0 10px rgba(241, 196, 15, 0.45);
    }
    .team-rank-badge.rank-2 {
      background: linear-gradient(135deg, #f5f6fa, #a4b0be);
      color: #000;
      box-shadow: 0 0 8px rgba(245, 246, 250, 0.35);
    }
    .team-rank-badge.rank-3 {
      background: linear-gradient(135deg, #e67e22, #d35400);
      color: #fff;
      box-shadow: 0 0 8px rgba(230, 126, 34, 0.35);
    }
    .team-rank-badge.rank-other {
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-muted);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* Team Sidebar (Đội Hình) — separate panel overlaying from right */
    .team-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      width: 360px;
      height: 100vh;
      background: rgba(14, 15, 26, 0.97);
      backdrop-filter: blur(20px);
      border-left: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      z-index: 500;
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: -6px 0 30px rgba(0,0,0,0.5);
    }

    .team-sidebar.open {
      transform: translateX(0);
    }

    .team-sidebar-header {
      padding: 16px 18px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .team-sidebar-title {
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .team-list-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .team-list-scroll::-webkit-scrollbar {
      width: 4px;
    }
    .team-list-scroll::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.12);
      border-radius: 10px;
    }

    .team-list-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 12px 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      transition: all 0.18s;
    }

    .team-list-item:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(100, 180, 255, 0.5);
      transform: translateX(-3px);
    }

    .team-list-item-name {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
    }

    .team-list-item-meta {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .team-list-arrow {
      color: var(--text-muted);
      font-size: 14px;
    }

    /* Team Detail Modal */
    .team-modal-box {
      background: #12141f;
      border: 1px solid rgba(100, 180, 255, 0.2);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 820px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 50px rgba(0,0,0,0.75);
      overflow: hidden;
      animation: modalSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .team-modal-header {
      padding: 16px 22px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255,255,255,0.02);
      flex-shrink: 0;
    }

    .team-modal-title {
      font-size: 18px;
      font-weight: 800;
      color: #fff;
    }

    .team-modal-counter {
      font-size: 13px;
      color: var(--accent-cyan);
      font-weight: 600;
      margin-left: 10px;
      background: rgba(0,242,254,0.1);
      border: 1px solid rgba(0,242,254,0.25);
      padding: 2px 10px;
      border-radius: 20px;
    }

    .team-modal-body {
      padding: 20px 22px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    /* Team Code Bar */
    .team-code-bar {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(0, 242, 254, 0.3);
      border-radius: var(--radius-sm);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .team-code-info {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .team-code-label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-muted);
    }
    .team-code-value {
      font-family: Consolas, Monaco, "Courier New", monospace;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--accent-cyan);
      background: rgba(0, 242, 254, 0.08);
      border: 1px dashed rgba(0, 242, 254, 0.45);
      padding: 4px 12px;
      border-radius: 4px;
      letter-spacing: 0.5px;
      user-select: all;
    }
    .btn-copy-team-code {
      background: linear-gradient(135deg, #00f2fe, #4facfe);
      color: #000;
      font-weight: 700;
      font-size: 12px;
      border: none;
      border-radius: var(--radius-sm);
      padding: 6px 14px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .btn-copy-team-code:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(0, 242, 254, 0.45);
    }

    /* Team Synergy Banner in Modal */
    .team-synergy-section {
      display: flex;
      flex-direction: column;
    }
    .board-synergy-banner {
      background: rgba(16, 15, 36, 0.85);
      border: 1px solid rgba(138, 110, 230, 0.35);
      border-radius: 6px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      box-shadow: inset 0 0 12px rgba(100, 80, 200, 0.15);
    }
    .synergy-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      padding: 3px 8px;
      font-size: 12px;
      font-weight: 600;
      color: #e4e6f0;
    }
    .synergy-diamond {
      width: 17px;
      height: 17px;
      background: linear-gradient(135deg, #a29bfe, #6c5ce7);
      border-radius: 2px;
      transform: rotate(45deg);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 5px rgba(108, 92, 231, 0.5);
    }
    .synergy-diamond-inner {
      transform: rotate(-45deg);
      font-size: 10px;
      font-weight: 900;
      color: #fff;
    }

    /* Zone label */
    .team-zone-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .team-zone-label::before {
      content: '';
      display: inline-block;
      width: 3px;
      height: 14px;
      background: var(--accent-cyan);
      border-radius: 2px;
    }

    /* Avatar slots */
    .team-slot-gear { display:flex; justify-content:center; gap:2px; margin-top:4px; }
    .team-slot-gear img { width:22px; height:22px; border-radius:4px; cursor:pointer; box-shadow:0 0 0 1px rgba(255,255,255,0.18); }
    .team-slot-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .team-slot {
      width: 70px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
    }

    .team-avatar-frame {
      width: 70px;
      height: 80px;
      border-radius: 4px;
      border: 1.5px dashed rgba(255,255,255,0.18);
      background: rgba(255,255,255,0.03);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    .team-avatar-frame.has-char {
      border: none;
      cursor: pointer;
    }

    .team-avatar-frame.has-char:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow: 0 0 14px rgba(255, 255, 255, 0.5) !important;
      z-index: 10;
    }

    .team-avatar-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .team-slot-stars {
      height: 14px;
      line-height: 14px;
      text-align: center;
      font-size: 11px;
      color: #ffd32a;
      text-shadow: 0 0 4px rgba(255, 211, 42, 0.4);
      letter-spacing: 1.5px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      user-select: none;
    }

    .team-slot-placeholder {
      font-size: 20px;
      color: rgba(255,255,255,0.18);
      pointer-events: none;
      user-select: none;
    }

    .team-slot-name {
      font-size: 10px;
      font-weight: 600;
      color: var(--text-muted);
      text-align: center;
      width: 70px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Equipment section */
    .team-equip-row {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .team-equip-slot {
      width: 52px;
      height: 52px;
      border-radius: 8px;
      border: 2px dashed rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.03);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: rgba(255,255,255,0.12);
    }

    .team-equip-arrow {
      color: rgba(100, 180, 255, 0.6);
      font-size: 18px;
      font-weight: 700;
    }

    .team-equip-section {
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 14px 16px;
      flex: 1;
    }

    .team-equip-section-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.7px;
    }

    .team-equip-two-col {
      display: flex;
      gap: 14px;
    }

    /* Viền xoay quanh phát sáng cho Nút Đội Hình trên Header */
    .btn-toggle-team {
      position: relative;
      overflow: hidden;
      background: transparent;
      border: none;
      color: #ffeaa7;
      padding: 9px 20px;
      border-radius: 10px;
      font-size: 13.5px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      z-index: 1;
      letter-spacing: 0.6px;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 0 18px rgba(241, 196, 15, 0.35);
    }

    .btn-toggle-team::before {
      content: "";
      position: absolute;
      top: -70%;
      left: -70%;
      width: 240%;
      height: 240%;
      background: conic-gradient(
        from 0deg,
        transparent 0deg,
        transparent 35deg,
        #f1c40f 90deg,
        #ff7675 140deg,
        #a29bfe 190deg,
        #00f2fe 280deg,
        #f1c40f 360deg
      );
      animation: borderGlowRotate 2.6s linear infinite;
      z-index: -2;
    }

    .btn-toggle-team::after {
      content: "";
      position: absolute;
      inset: 2px;
      background: linear-gradient(135deg, #20183b 0%, #101224 100%);
      border-radius: 8px;
      z-index: -1;
      transition: background 0.2s;
    }

    .btn-toggle-team:hover {
      transform: translateY(-2px) scale(1.02);
      color: #fff;
      box-shadow: 0 0 30px rgba(241, 196, 15, 0.65), 0 0 12px rgba(162, 155, 254, 0.5);
    }

    .btn-toggle-team:hover::after {
      background: linear-gradient(135deg, #2c2252 0%, #171a33 100%);
    }

    /* Tier List Container */
    .tier-list-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .tier-row {
      background: rgba(18, 20, 31, 0.85);
      backdrop-filter: blur(10px);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: stretch;
      min-height: 130px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0,0,0,0.3);
      transition: border-color 0.2s;
    }

    .tier-row:hover {
      border-color: rgba(255, 255, 255, 0.2);
    }

    .tier-badge-col {
      width: 130px;
      min-width: 130px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 12px 8px;
      user-select: none;
      position: relative;
    }

    .tier-title-main {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 0.5px;
      line-height: 1.1;
      text-transform: uppercase;
    }

    .tier-title-sub {
      font-size: 11px;
      font-weight: 700;
      margin-top: 4px;
      line-height: 1.2;
      opacity: 0.95;
    }

    .tier-cards-col {
      flex: 1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      padding: 12px 18px;
      gap: 14px;
      background: rgba(14, 16, 26, 0.45);
    }

    /* Character Card (Rectangular Avatar per user request) */
    .char-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 74px;
      cursor: pointer;
      position: relative;
      transition: transform 0.2s ease, filter 0.2s ease;
      user-select: none;
    }

    .char-card:hover {
      transform: translateY(-5px) scale(1.06);
      z-index: 10;
    }

    .char-card:hover .avatar-wrapper {
      box-shadow: 0 0 16px rgba(255, 255, 255, 0.6) !important;
    }

    .avatar-wrapper {
      width: 70px;
      height: 92px;
      border-radius: 6px;
      position: relative;
      padding: 2px;
      background: #151724;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      overflow: hidden;
    }

    /* Cost border colors: xám = 1 xu, xanh lá = 2 xu, xanh dương = 3 xu, tím = 4 xu, vàng = 5 xu */
    .avatar-wrapper.cost-5 {
      border: 2.5px solid var(--cost-5);
      box-shadow: 0 0 10px rgba(241, 196, 15, 0.4);
    }
    .avatar-wrapper.cost-4 {
      border: 2.5px solid var(--cost-4);
      box-shadow: 0 0 10px rgba(165, 94, 234, 0.4);
    }
    .avatar-wrapper.cost-3 {
      border: 2.5px solid var(--cost-3);
      box-shadow: 0 0 10px rgba(56, 103, 214, 0.4);
    }
    .avatar-wrapper.cost-2 {
      border: 2.5px solid var(--cost-2);
      box-shadow: 0 0 10px rgba(32, 191, 107, 0.4);
    }
    .avatar-wrapper.cost-1 {
      border: 2.5px solid var(--cost-1);
      box-shadow: 0 0 6px rgba(149, 165, 166, 0.3);
    }

    .avatar-img {
      width: 100%;
      height: 100%;
      border-radius: 4px;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }

    /* === Kiểu thẻ của game: nền chuyển màu (trên→dưới) + viền dưới theo cost ===
       Mã màu lấy từ trang game. Đang áp dụng thử cho Phainon (xem GAME_STYLE_IDS ở JS). */
    .gs-cost-1 { --gs-rarity:#CDCDD8; --gs-start:rgba(140,140,140,1); --gs-end:rgba(6,1,27,1); }
    .gs-cost-2 { --gs-rarity:#6EE0B6; --gs-start:rgba(94,156,150,1);  --gs-end:rgba(6,1,27,1); }
    .gs-cost-3 { --gs-rarity:#73B0F4; --gs-start:rgba(113,128,210,1); --gs-end:rgba(6,1,27,1); }
    .gs-cost-4 { --gs-rarity:#C197FF; --gs-start:rgba(155,123,218,1); --gs-end:rgba(6,1,27,1); }
    .gs-cost-5 { --gs-rarity:#FFCF70; --gs-start:rgba(203,158,96,1);  --gs-end:rgba(6,1,27,1); }
    /* Kích thước & bố cục y hệt thẻ game: thẻ 70x80 (7:8), khung #121212 viền #2F2D2A,
       vùng ảnh 66x71 (cách mép 2px) có nền chuyển màu, thanh màu cost dày 4px nằm dưới cùng. */
    .avatar-wrapper.gs,
    .modal-avatar-rect.gs,
    .team-avatar-frame.gs {
      --gs-bg:
        linear-gradient(var(--gs-rarity), var(--gs-rarity)) 2px 74px / 66px 4px no-repeat,
        linear-gradient(to bottom, var(--gs-start) 20%, var(--gs-end) 100%) 2px 2px / 66px 71px no-repeat;
      width: 70px;
      height: 80px;
      border: none;
      border-radius: 0;
      padding: 0;
      box-shadow: inset 0 0 0 1px #2F2D2A;
      background: var(--gs-bg), #121212;
    }
    .avatar-wrapper.gs,
    .team-avatar-frame.gs { position: relative; overflow: hidden; }
    .avatar-wrapper.gs .avatar-img,
    .team-avatar-frame.gs .avatar-img {
      position: absolute;
      left: 2px; top: 2px;
      width: 66px; height: 71px;
      border-radius: 0;
      object-fit: cover;
      object-position: top center;
    }
    .avatar-wrapper.gs .pos-indicator-tag { z-index: 2; }
    /* Popup: ảnh <img> nên dùng padding để ảnh nằm đúng vùng 66x71 */
    .modal-avatar-rect.gs {
      box-sizing: border-box;
      padding: 2px 2px 7px 2px;
      object-fit: cover;
      object-position: top center;
    }

    /* Position Indicator attached to top-right of avatar */
    .pos-indicator-tag {
      position: absolute;
