    function normalizeLinkName(name) {
      if (!name) return '';
      const s = name.trim().toLowerCase();
      if (s === 'cõi mộng đan xen' || s === 'mộng cảnh đan xen') return 'Mộng Cảnh Đan Xen';
      if (s === 'nhà hàng hoàng kim' || s === 'đại khách sạn hoàng kim') return 'Đại Khách Sạn Hoàng Kim';
      if (s === 'khu vườn kỳ thú' || s === 'vườn kỳ thú') return 'Vườn Kỳ Thú';
      if (s === 'trò chơi ảo nguyệt' || s === 'trò chơi huyễn nguyệt') return 'Trò Chơi Huyễn Nguyệt';
      if (s === 'đường ray bạc khai phá' || s === 'đường ray khai phá') return 'Đường Ray Khai Phá';
      return name.trim();
    }

    // ===== TEAM SIDEBAR =====
    function toggleTeamSidebar() {
      const sidebar = document.getElementById('teamSidebar');
      sidebar.classList.toggle('open');
      if (sidebar.classList.contains('open')) {
        renderTeamList();
        const layout = document.getElementById('appLayout');
        if (layout) layout.classList.add('sidebar-collapsed');
      }
    }

    function renderTeamList() {
      const container = document.getElementById('teamListScroll');
      container.innerHTML = '';
      
      // Sắp xếp các đội theo rank (Top 1, Top 2...) nếu có; chưa có rank thì xếp cuối
      const sortedTeams = [...TEAMS].sort((a, b) => {
        const rA = (a.rank !== undefined && a.rank !== null && a.rank !== '') ? Number(a.rank) : 9999;
        const rB = (b.rank !== undefined && b.rank !== null && b.rank !== '') ? Number(b.rank) : 9999;
        return rA - rB;
      });

      sortedTeams.forEach(team => {
        const item = document.createElement('div');
        item.className = 'team-list-item';
        const rankVal = (team.rank !== undefined && team.rank !== null && team.rank !== '') ? Number(team.rank) : null;
        const rankDisplay = rankVal ? `TOP ${rankVal}` : '';
        const rankClass = rankVal === 1 ? 'rank-1' : rankVal === 2 ? 'rank-2' : rankVal === 3 ? 'rank-3' : 'rank-other';
        const rankBadgeHtml = rankDisplay ? `<span class="team-rank-badge ${rankClass}">${rankDisplay}</span>` : '';

        const codeDisplay = (team.code || team.team_code) ? ` · Mã: <span style="color:var(--accent-cyan);font-weight:600;">${team.code || team.team_code}</span>` : '';
        item.innerHTML = `
          <div style="display:flex;align-items:center;gap:10px;">
            ${rankBadgeHtml}
            <div>
              <div class="team-list-item-name">${team.name || 'Đội hình chưa đặt tên'}</div>
              <div class="team-list-item-meta">Trên Sân: ${team.tren_san.filter(Boolean).length}/${team.tren_san.length} · Dự Bị: ${team.du_bi.filter(Boolean).length}/${team.du_bi.length}${codeDisplay}</div>
            </div>
          </div>
          <span class="team-list-arrow">›</span>
        `;
        item.onclick = () => openTeamModal(team.id);
        container.appendChild(item);
      });
    }

    // ===== TEAM MODAL =====
    function openTeamModal(teamId) {
      const team = TEAMS.find(t => t.id === teamId);
      if (!team) return;

      const rankBadge = (team.rank !== undefined && team.rank !== null && team.rank !== '') ? `[TOP ${team.rank}] ` : '';
      document.getElementById('teamModalTitle').textContent = rankBadge + (team.name || 'Đội hình');
      document.getElementById('teamModalCounter').textContent = team.counter || (team.rank ? `Top ${team.rank}` : '');

      const body = document.getElementById('teamModalBody');
      body.innerHTML = '';

      // --- Mã Đội Hình (nếu có) ---
      const teamCode = team.code || team.team_code || '';
      if (teamCode) {
        const codeBar = document.createElement('div');
        codeBar.className = 'team-code-bar';
        codeBar.innerHTML = `
          <div class="team-code-info">
            <span class="team-code-label">📋 Mã Đội Hình:</span>
            <span class="team-code-value">${teamCode}</span>
          </div>
          <button class="btn-copy-team-code" onclick="copyTeamCode('${teamCode.replace(/'/g, "\\'")}')">📋 Sao Chép Mã</button>
        `;
        body.appendChild(codeBar);
      }

      // --- Liên Kết Đội Hình (Synergy / Bonds Banner) ---
      const bondCounts = {};
      const allPlacedIds = [...team.tren_san, ...team.du_bi].filter(Boolean);
      allPlacedIds.forEach(cid => {
        const c = charMap[cid];
        if (c && Array.isArray(c.links)) {
          c.links.forEach(l => {
            const norm = normalizeLinkName(l);
            bondCounts[norm] = (bondCounts[norm] || 0) + 1;
          });
        }
      });

      // Tăng số tầng kích liên kết từ các Ấn (Huy Hiệu) đã trang bị
      (team.tren_san || []).forEach((cid, idx) => {
        if (cid && team.tren_gear && team.tren_gear[idx]) {
          team.tren_gear[idx].forEach(gearFile => {
            if (gearFile && BADGE_TO_LINK[gearFile]) {
              const linkName = normalizeLinkName(BADGE_TO_LINK[gearFile]);
              bondCounts[linkName] = (bondCounts[linkName] || 0) + 1;
            }
          });
        }
      });

      (team.du_bi || []).forEach((cid, idx) => {
        if (cid && team.du_gear && team.du_gear[idx]) {
          team.du_gear[idx].forEach(gearFile => {
            if (gearFile && BADGE_TO_LINK[gearFile]) {
              const linkName = normalizeLinkName(BADGE_TO_LINK[gearFile]);
              bondCounts[linkName] = (bondCounts[linkName] || 0) + 1;
            }
          });
        }
      });

      const bondEntries = Object.entries(bondCounts).sort((a, b) => b[1] - a[1]);
      if (bondEntries.length > 0) {
        const synergySection = document.createElement('div');
        synergySection.className = 'team-synergy-section';
        synergySection.innerHTML = `<div class="team-zone-label" style="margin-bottom:8px;">✨ Liên Kết Kích Hoạt (${bondEntries.length})</div>`;
        const synergyBanner = document.createElement('div');
        synergyBanner.className = 'board-synergy-banner';
        bondEntries.forEach(([bondName, count]) => {
          const item = document.createElement('div');
          item.className = 'synergy-item';
          item.innerHTML = `<span class="synergy-diamond"><span class="synergy-diamond-inner">${count}</span></span><span>${bondName}</span>`;
          synergyBanner.appendChild(item);
        });
        synergySection.appendChild(synergyBanner);
        body.appendChild(synergySection);
      }

      // --- Khu Vực Trên Sân ---
      const trenSanSection = document.createElement('div');
      trenSanSection.innerHTML = `<div class="team-zone-label">🗡️ Khu Vực Trên Sân</div>`;
      const trenRow = document.createElement('div');
      trenRow.className = 'team-slot-row';
      team.tren_san.forEach((charId, i) => {
        const st = (team.tren_stars || [])[i];
        trenRow.appendChild(buildSlot(charId, i, (team.tren_gear||[])[i], st));
      });
      trenSanSection.appendChild(trenRow);
      body.appendChild(trenSanSection);

      // --- Khu Vực Dự Bị ---
      const duBiSection = document.createElement('div');
      duBiSection.innerHTML = `<div class="team-zone-label">🛡️ Khu Vực Dự Bị</div>`;
      const duBiRow = document.createElement('div');
      duBiRow.className = 'team-slot-row';
      team.du_bi.forEach((charId, i) => {
        const st = (team.du_stars || [])[i];
        duBiRow.appendChild(buildSlot(charId, i, (team.du_gear||[])[i], st));
      });
      duBiSection.appendChild(duBiRow);
      body.appendChild(duBiSection);

      // --- Equipment ---
      const equipSection = document.createElement('div');
      equipSection.className = 'team-equip-two-col';
      equipSection.appendChild(buildEquipBlock('Ưu Tiên Trang Bị Cơ Bản', team.equip_basic, '#64b4ff'));
      equipSection.appendChild(buildEquipBlock('Ưu Tiên Trang Bị Tiến Cấp', team.equip_advanced, '#a29bfe'));
      body.appendChild(equipSection);

      document.getElementById('teamModalBackdrop').classList.add('open');
    }

    function copyTeamCode(code) {
      if (!code) return;
      navigator.clipboard.writeText(code).then(() => {
        showToast('✓ Đã sao chép mã đội hình: ' + code);
      }).catch(() => {
        showToast('✓ Mã đội hình: ' + code);
      });
    }

    function buildSlot(charId, idx, gear, starCount) {
      const wrapper = document.createElement('div');
      wrapper.className = 'team-slot';

      const frame = document.createElement('div');
      frame.className = 'team-avatar-frame';

      if (charId && charMap[charId]) {
        const c = charMap[charId];
        frame.classList.add('has-char');
        const gsCost = GS_HEX_TO_COST[(c.cost_hex || '').toLowerCase()] || c.cost;
        if (gsCost) {
          frame.classList.add('gs', `gs-cost-${gsCost}`);
        } else {
          frame.style.borderColor = c.cost_hex || '#888';
        }
        frame.style.cursor = 'pointer';
        frame.title = c.tier_name;
        frame.onclick = () => openCharModal(c.id);

        const img = document.createElement('img');
        img.className = 'avatar-img';
        img.src = AVATAR_B64[c.avatar] || ('avatars/' + c.avatar);
        img.alt = c.tier_name;
        frame.appendChild(img);

        wrapper.appendChild(frame);

        const starsEl = document.createElement('div');
        starsEl.className = 'team-slot-stars';
        if (starCount && starCount > 0) {
          starsEl.textContent = '★'.repeat(starCount);
        }
        wrapper.appendChild(starsEl);

        const nameEl = document.createElement('div');
        nameEl.className = 'team-slot-name';
        nameEl.textContent = c.tier_name;
        wrapper.appendChild(nameEl);
      } else {
        const ph = document.createElement('span');
        ph.className = 'team-slot-placeholder';
        ph.textContent = '+';
        frame.appendChild(ph);
        wrapper.appendChild(frame);

        const starsEl = document.createElement('div');
        starsEl.className = 'team-slot-stars';
        wrapper.appendChild(starsEl);

        const nameEl = document.createElement('div');
        nameEl.className = 'team-slot-name';
        nameEl.textContent = '—';
        wrapper.appendChild(nameEl);
      }

      if (gear && gear.length) {
        const gr = document.createElement('div');
        gr.className = 'team-slot-gear';
        gear.forEach(f => {
          const nm = GEAR_NAME[f];
          const g = document.createElement('img');
          g.src = 'assets/trang_bi/' + f;
          g.alt = nm || '';
          g.title = nm || '';
          if (nm && EQUIP_META[nm]) {
            g.onclick = () => showEquipModal(nm);
            g.onmouseenter = (e) => showEquipTooltip(e, nm);
            g.onmouseleave = () => hideEquipTooltip();
          }
          gr.appendChild(g);
        });
        wrapper.appendChild(gr);
      }

      return wrapper;
    }

    function buildEquipBlock(title, slots, arrowColor) {
      const block = document.createElement('div');
      block.className = 'team-equip-section';
      block.innerHTML = `<div class="team-equip-section-title">${title}</div>`;
      const row = document.createElement('div');
      row.className = 'team-equip-row';
      slots.forEach((item, i) => {
        const slot = document.createElement('div');
        slot.className = 'team-equip-slot';
        slot.textContent = item ? '🧰' : '?';
        row.appendChild(slot);
        if (i < slots.length - 1) {
          const arrow = document.createElement('span');
          arrow.className = 'team-equip-arrow';
          arrow.style.color = arrowColor;
          arrow.textContent = '›';
          row.appendChild(arrow);
        }
      });
      block.appendChild(row);
      return block;
    }


    // ===== PAGE TAB SWITCHING =====
    function switchPageTab(tab) {
      document.querySelectorAll('.page-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
      const section = document.getElementById('section-' + tab);
      if (section) section.classList.add('active');
      const btn = [...document.querySelectorAll('.page-tab-btn')].find(b => b.getAttribute('onclick').includes("'" + tab + "'"));
      if (btn) btn.classList.add('active');
    }
    function switchCLTab(e, tab) {
      document.querySelectorAll('.cl-subtab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.cl-subtab-section').forEach(s => s.classList.remove('active'));
      e.currentTarget.classList.add('active');
      const sec = document.getElementById('cl-sub-' + tab);
      if (sec) sec.classList.add('active');
    }
  
